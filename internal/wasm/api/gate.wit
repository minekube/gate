  json-to-snbt: func(j: option<raw-message-6f3a8bd48089>) -> result<string, gate-error>;
  /// SnbtToBinaryTag converts a stringified NBT to binary tag.
  snbt-to-binary-tag: func(snbt: string) -> result<raw-message-0bf1364d62a7, gate-error>;
  /// SnbtToJSON converts a stringified NBT to JSON.
