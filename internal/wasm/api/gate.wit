interface pkg-edition-java-proto-packet-plugin {
  use gate-types.{gate-error, message-pointer, packet-context-pointer, protocol-e8c68391e5ba, reader-4d25c51b00a6, regexp, writer-38b5996d575b};

  get-brand-channel: func() -> string;
  get-brand-channel-legacy: func() -> string;
  /// Channels fetches all the channels in a register or unregister plugin message.
  channels: func(p: option<borrow<message-pointer>>) -> option<list<string>>;
  /// ConstructChannelsPacket constructs a channel (un)register packet.
  /// channels must not be empty! Note that the Message's Retained field remains nil.
  construct-channels-packet: func(protocol: protocol-e8c68391e5ba, channels: option<list<string>>) -> option<own<message-pointer>>;
  get-invalid-identifier-regex: func() -> option<own<regexp>>;
  set-invalid-identifier-regex: func(value: option<borrow<regexp>>);
  /// IsRegister determines whether this plugin
  /// message is being used to register plugin channels.
  is-register: func(p: option<borrow<message-pointer>>) -> bool;
  /// IsUnregister determines whether this plugin
  /// message is being used to unregister plugin channels.
  is-unregister: func(p: option<borrow<message-pointer>>) -> bool;
  /// LegacyRegister determines whether this plugin message is a legacy (<1.13) registration plugin message.
  legacy-register: func(p: option<borrow<message-pointer>>) -> bool;
  /// LegacyUnregister determines whether this plugin message is a legacy (<1.13) un-registration plugin message.
  legacy-unregister: func(p: option<borrow<message-pointer>>) -> bool;
  /// MaxServerboundPayloadSize is the maximum size (in bytes) of a serverbound
  /// plugin message payload. This matches the vanilla client limit; rejecting
  /// larger serverbound payloads prevents a client from abusing plugin messages.
  /// Clientbound payloads (proxy<-backend) are not subject to this limit.
  get-max-serverbound-payload-size: func() -> s64;
  /// McBrand determines whether this is a brand plugin message.
  /// This is shown on the client.
  mc-brand: func(p: option<borrow<message-pointer>>) -> bool;
  message-decode: func(self: borrow<message-pointer>, c: option<borrow<packet-context-pointer>>, r: option<borrow<reader-4d25c51b00a6>>) -> result<_, gate-error>;
  message-encode: func(self: borrow<message-pointer>, c: option<borrow<packet-context-pointer>>, wr: option<borrow<writer-38b5996d575b>>) -> result<_, gate-error>;
  /// ReadBrandMessage reads the brand message from the given packet data.
  /// The returned string will be empty if the data is invalid.
  /// Some clients (mostly poorly-implemented bots) do not send validly-formed brand messages.
  /// In order to accommodate their broken behavior, we'll first try to read in the 1.8 format, and
  /// if that fails, treat it as a 1.7-format message (which has no prefixed length).
  /// (The message the proxy sends will be in the correct format depending on the protocol.)
  read-brand-message: func(data: option<list<u8>>) -> string;
  get-register-channel: func() -> string;
  get-register-channel-legacy: func() -> string;
  /// RewriteMinecraftBrand rewrites the brand message to indicate the presence of the proxy.
  rewrite-minecraft-brand: func(message: option<borrow<message-pointer>>, protocol: protocol-e8c68391e5ba) -> option<own<message-pointer>>;
  /// TransformLegacyToModernChannel transforms a plugin
  /// message channel from a "legacy" (<1.13) form to a modern one.
  transform-legacy-to-modern-channel: func(name: string) -> string;
  get-unregister-channel: func() -> string;
  get-unregister-channel-legacy: func() -> string;
}

