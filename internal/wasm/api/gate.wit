  new-capped-set-0ec33fd43911: func(cap: s64) -> option<own<capped-set-e7934a7a84ba>>;
  /// NewString creates a String from a list of values.
  new-string: func(items: option<list<string>>) -> option<gate-string>;
  /// Delete removes all items from the set.
  string-delete: func(self: gate-string, items: option<list<string>>) -> option<gate-string>;
  /// Has returns true if and only if item is contained in the set.
  string-has: func(self: gate-string, item: string) -> bool;
  /// HasAll returns true if and only if all items are contained in the set.
  string-has-all: func(self: gate-string, items: option<list<string>>) -> bool;
  /// Insert adds items to the set.
  string-insert: func(self: gate-string, items: option<list<string>>) -> option<gate-string>;
  /// InsertSet inserts all items from sets into s.
  string-insert-set: func(self: gate-string, sets: option<list<option<gate-string>>>) -> option<gate-string>;
  /// Len returns the size of the set.
  string-len: func(self: gate-string) -> s64;
  /// UnsortedList returns the slice with contents in random order.
  string-unsorted-list: func(self: gate-string) -> option<list<string>>;
}

interface pkg-util-uuid {
  use gate-types.{gate-error, uuid, uuid-pointer};

  /// FromBytes creates a new UUID from a byte slice. Returns an error if the slice
  /// does not have a length of 16. The bytes are copied from the slice.
  from-bytes: func(b: option<list<u8>>) -> result<uuid, gate-error>;
  /// New creates a new random UUID or panics.
  new: func() -> uuid;
  /// Empty UUID, all zeros
  get-nil: func() -> uuid;
  set-nil: func(value: uuid);
  offline-player-uuid: func(username: string) -> uuid;
  /// Parse decodes s into a UUID or returns an error.  Both the standard UUID
  /// forms of xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx and
  /// urn:uuid:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx are decoded as well as the
  /// Microsoft encoding {xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx} and the raw hex
  /// encoding: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.
  parse: func(s: string) -> result<uuid, gate-error>;
  /// ParseBytes is like Parse, except it parses a byte slice instead of a string.
  parse-bytes: func(b: option<list<u8>>) -> result<uuid, gate-error>;
  uuid-marshal-json: func(self: uuid) -> result<option<list<u8>>, gate-error>;
  /// String returns the string form of uuid,
  /// xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx , or "" if uuid is invalid.
  uuid-string: func(self: uuid) -> string;
  /// Undashed returns the undashed string form of the uuid.
  uuid-undashed: func(self: uuid) -> string;
  uuid-unmarshal-json: func(self: borrow<uuid-pointer>, b: option<list<u8>>) -> result<_, gate-error>;
}

interface pkg-util-validation {
  use gate-types.{gate-error};

  /// ContainsIllegalCharacter check if a message contains illegal characters in Minecraft chat.
  /// It is not possible to send certain characters in the chat like:
  /// section symbol, DEL, and all characters below space.
  contains-illegal-character: func(s: string) -> bool;
  /// IsAllowedCharacter checks if c is a allowed character in Minecraft chat.
  is-allowed-character: func(c: s32) -> bool;
  /// Constants obtained from https://github.com/kubernetes/apimachinery/blob/master/pkg/util/validation/validation.go
  get-qualified-name-err-msg: func() -> string;
  /// Constants obtained from https://github.com/kubernetes/apimachinery/blob/master/pkg/util/validation/validation.go
  get-qualified-name-max-length: func() -> s64;
  valid-host-port: func(host-and-port: string) -> result<_, gate-error>;
  valid-server-name: func(str: string) -> bool;
}

interface pkg-version {
  use gate-types.{anonymous-record-521544b5d760d299, header-67fa3320e7af};

  gate-string: func() -> string;
  user-agent: func() -> string;
  user-agent-header: func() -> option<header-67fa3320e7af>;
  /// Version information set by build flags
  /// Version is the current version of Gate.
  /// Set using -ldflags "-X go.minekube.com/gate/pkg/version.Version=v1.2.3"
  get-version: func() -> string;
  set-version: func(value: string);
}

