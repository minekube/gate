interface pkg-edition-java-proto-util-queue {
  use gate-types.{callback-9b79f3eb4945, callback-f39d53d38ffd, direction, error, gate-error, packet, play-packet-queue, protocol-e8c68391e5ba};

  /// ErrQueueFull is returned when the play packet queue exceeds its maximum size.
  get-err-queue-full: func() -> option<own<error>>;
  set-err-queue-full: func(value: option<borrow<error>>);
  /// NewPlayPacketQueue creates a new PlayPacketQueue with the given protocol version, and direction.
  new-play-packet-queue: func(version: protocol-e8c68391e5ba, direction: direction) -> option<own<play-packet-queue>>;
  /// Queue returns true if the packet was queued.
  /// If the packet is not registered in the CONFIG state, it will be queued.
  /// Otherwise, it will not be queued and false will be returned.
  /// Returns an error if the queue is full.
  play-packet-queue-queue: func(self: borrow<play-packet-queue>, packet: option<borrow<packet>>) -> result<bool, gate-error>;
  /// ReleaseQueue releases all packets in the queue to the sink packet writer.
  /// It iterates over the queue, buffering each packet and flushing the sink.
  play-packet-queue-release-queue: func(self: borrow<play-packet-queue>, buffer: option<own<callback-f39d53d38ffd>>, flush: option<own<callback-9b79f3eb4945>>) -> result<_, gate-error>;
}

