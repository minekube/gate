  use gate-types.{addr, gate-error, prefix, trusted-networks};

  /// Host returns the host of net.Addr.
  host: func(addr: option<borrow<addr>>) -> string;
  /// HostPort returns the split host and port of a net.Addr.
  host-port: func(addr: option<borrow<addr>>) -> tuple<string, u16>;
  /// HostStr returns the host of the address.
  host-str: func(addr: string) -> string;
  /// NewAddr creates a new net.Addr without format validation.
  new-addr: func(addr: string, network: string) -> option<own<addr>>;
  /// Parse parses addr and constructs a net.Addr with
  /// the specified network. A 0 port is removed.
  parse: func(addr: string, network: string) -> result<option<own<addr>>, gate-error>;
  /// ParseTrustedNetworks parses a list of IP addresses ("10.1.2.3", "::1") and
  /// CIDR blocks ("10.0.0.0/8", "fc00::/7") into TrustedNetworks.
  parse-trusted-networks: func(networks: option<list<string>>) -> result<option<trusted-networks>, gate-error>;
  /// Port returns the port of net.Addr.
  port: func(addr: option<borrow<addr>>) -> u16;
  /// PortStr returns the port of the address.
  port-str: func(addr: string) -> u16;
  /// Contains reports whether addr is within any of the trusted networks.
  /// It returns false for addresses that carry no parsable IP, so unknown
  /// address types are never trusted.
  trusted-networks-contains: func(self: trusted-networks, addr: option<borrow<addr>>) -> bool;
  /// ContainsStr reports whether the host (an IP address without port)
  /// is within any of the trusted networks.
  trusted-networks-contains-str: func(self: trusted-networks, host: string) -> bool;
  /// String returns the trusted networks in CIDR notation.
  trusted-networks-string: func(self: trusted-networks) -> string;
}

interface pkg-util-permission {
  use gate-types.{subject, tri-state};

  get-false: func() -> tri-state;
  subject-has-permission: func(self: borrow<subject>, permission: string) -> bool;
  subject-permission-value: func(self: borrow<subject>, permission: string) -> tri-state;
  /// Bool returns the bool value of a TriState where
  /// Undefined is converted to false.
  tri-state-bool: func(self: tri-state) -> bool;
  get-true: func() -> tri-state;
  get-undefined: func() -> tri-state;
}

interface pkg-util-sets {
  use gate-types.{anonymous-dynamic-092a23419e896b03, anonymous-record-ec55077cfd4e27a9, capped-set, capped-set-c736fcd16cfb, capped-set-e7934a7a84ba, empty, gate-string};

  capped-set-add: func(self: borrow<capped-set>, items: option<list<option<own<anonymous-dynamic-092a23419e896b03>>>>);
  capped-set-len: func(self: borrow<capped-set>) -> s64;
  capped-set-remove: func(self: borrow<capped-set>, items: option<list<option<own<anonymous-dynamic-092a23419e896b03>>>>);
  capped-set-unsorted-list: func(self: borrow<capped-set>) -> option<list<option<own<anonymous-dynamic-092a23419e896b03>>>>;
